<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app's Info.plist by Tauri. Local sync finds the user's other devices over mDNS;
     macOS asks before an app uses the local network, and shows this reason. -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Mnemax finds your other devices on this Wi-Fi to sync your rounds, only while Sync is open.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_mnemax._tcp</string>
  </array>
</dict>
</plist>
