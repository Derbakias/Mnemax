<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the macOS app may use beyond the defaults. The camera, only to scan a pairing QR code: without this,
     macOS's hardened runtime keeps it off even after the person allows it. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
